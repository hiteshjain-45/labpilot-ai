# Development: the Vite dev server proxies /api to this address.
VITE_BACKEND_URL=http://127.0.0.1:8000
# Only set when the API is served from a different origin than the page (then also set CORS_ORIGINS on the API).
# VITE_API_URL=https://api.example.com
# Set to false at build time to hide the demo-login buttons on the sign-in page.
VITE_SHOW_DEMO=true

# Copy to backend/.env (or the project root) and edit. Every value is optional: with no file at all the app
# runs with SQLite, the rule-based Copilot and the subprocess sandbox.

# ---- application
APP_ENV=development
# Default: backend/labpilot.db (an absolute path, the same for the server and the seed script). Uncomment only to change it.
# DATABASE_URL=sqlite:////absolute/path/to/labpilot.db
# postgresql+psycopg://user:password@localhost:5432/labpilot   (install a driver, e.g. pip install "psycopg[binary]")
# With APP_ENV=production the server refuses to start unless this is a random string of 32+ characters.
# REQUIRED in any shared deployment: a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me-before-deploying
ACCESS_TOKEN_MINUTES=480
# Comma-separated browser origins allowed to call the API directly (the Vite proxy does not need this).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI Copilot (leave the keys empty to use the built-in rule-based guidance)
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI-compatible if OPENAI_API_KEY is set, else rule-based
# other values: mock | anthropic | openai
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works, for example a local Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20

# ---- code execution sandbox
# subprocess = tested and used by default. docker = experimental and NOT tested in this build (see docs/SECURITY.md).
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT_SECONDS=3
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_CHARS=64000
SANDBOX_MAX_CONCURRENT=4
SANDBOX_DOCKER_IMAGE=python:3.12-slim
MAX_CODE_CHARS=20000

# ---- abuse limits
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
EXEC_MAX_PER_MINUTE=60
